# ═══════════════════════════════════════════════════════════════
# Mecville Frontend — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real credentials.
# VITE_ prefix is required — only vars with this prefix are
# exposed to the client-side bundle.

# ── Supabase ──────────────────────────────────────────────────
# Get from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
# anon public key ONLY — never use the service_role key here!
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── Stripe ────────────────────────────────────────────────────
# Publishable key (safe for client-side). Use pk_live_ for production.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
