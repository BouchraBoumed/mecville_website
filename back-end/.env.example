# ═══════════════════════════════════════════════════════════════
# Mecville Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git.

# ── Supabase ──────────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# service_role key — bypasses RLS. KEEP SECRET. Backend only.
SUPABASE_SECRET_KEY=your-service-role-key
# anon public key — used for authenticated client requests
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── Stripe ────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Get from Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Publishable key (also needed in frontend .env)
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ── PayPal (optional) ─────────────────────────────────────────
# Set ENABLE_PAYPAL=false to disable PayPal entirely
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_API=https://api-m.paypal.com
ENABLE_PAYPAL=true

# ── Server ────────────────────────────────────────────────────
# Port Render assigns via its own env var; fallback to 3001 locally.
PORT=3001
# The origin allowed to call the API (CORS).
# In development: http://localhost:5173
# In production (Vercel frontend): https://your-app.vercel.app
# Comma-separated list are supported.
CORS_ORIGIN=http://localhost:5173
# Set to 'production' for production deployments
NODE_ENV=development

# ── Email (SMTP) ──────────────────────────────────────────────
# Used for contact form notifications and order confirmations.
# If not set, emails are logged to console (dev mode).
# For Gmail, use an App Password (not your regular password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=contact@mecville.com

# ── Error Tracking (optional) ─────────────────────────────────
# Sentry DSN for backend error tracking. Leave empty to disable.
SENTRY_DSN=
